# Copy this file to .env and add your own optional keys.
#
# Vite exposes every VITE_* value in the browser bundle. Treat these values as
# public configuration, not private secrets. Never commit your real .env file.

# Weather data — primary provider (optional but recommended).
# Create a free key at https://openweathermap.org/api
# When this is empty, or the request fails, WeatherBoard automatically falls
# back to the keyless Open-Meteo API.
VITE_OPENWEATHER_API_KEY=

# Optional: GeoDB Cities via RapidAPI — https://rapidapi.com/wirefreethought/api/geodb-cities
# Used for live city autocomplete. When this is empty, WeatherBoard falls back
# to the keyless Open-Meteo Geocoding API.
VITE_RAPIDAPI_KEY=

# Optional API overrides (defaults are applied in the service layer).
# VITE_OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5
# VITE_OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
# VITE_GEODB_BASE_URL=https://wft-geo-db.p.rapidapi.com/v1/geo
